{
    "env": {
        "VITE_API_BASE_URL": "/_/backend/api",
        "VITE_SOCKET_URL": "/_/backend"
    },
    "build": {
        "env": {
            "VITE_API_BASE_URL": "/_/backend/api",
            "VITE_SOCKET_URL": "/_/backend"
        }
    },
    "experimentalServices": {
        "frontend": {
            "entrypoint": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "entrypoint": "backend/src/index.ts",
            "routePrefix": "/_/backend",
            "framework": "express"
        }
    }
}
